LIVEKIT_URL=wss://YOUR-LIVEKIT-CLOUD-PROJECT.livekit.cloud
LIVEKIT_API_KEY=your_livekit_cloud_api_key
LIVEKIT_API_SECRET=your_livekit_cloud_api_secret

# SambaNova Cloud API key from https://cloud.sambanova.ai/
SAMBANOVA_API_KEY=27d86239-2ef7-4967-8be5-c22e4af2ed25
# Optional: use another SambaNova model or compatible endpoint.
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_KANNADA_SPEAKER=aparna_hi_customer
SARVAM_TELUGU_SPEAKER=aparna_hi_customer

# Optional Google Cloud TTS for Kannada. Use a service account with Cloud TTS access.
KANNADA_TTS_PROVIDER=sarvam
GOOGLE_TTS_API_KEY=
GOOGLE_GEMINI_TTS_VOICE=Kore
GOOGLE_TTS_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=path_to_google_cloud_credentials.json
GOOGLE_KANNADA_VOICE=kn-IN-Chirp3-HD-Kore

# VoBiz SIP settings for outbound calls.
# VOBIZ_SIP_DOMAIN must be the SIP host only, without sip://.
VOBIZ_SIP_DOMAIN=your_domain.sip.vobiz.ai
VOBIZ_USERNAME=your_username
VOBIZ_PASSWORD=your_password
VOBIZ_OUTBOUND_NUMBER=+91XXXXXXXXXX
VOBIZ_DESTINATION_COUNTRY=IN

# Created by running: python setup_outbound_trunk.py
OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxxxxx

# Webhook called by local tests or Google Apps Script.
WEBHOOK_SECRET=easyedu-secret-2026

# Google Apps Script Web App URL used by inbound/lead logging.
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
OPENROUTER_API_KEY=your_openrouter_api_key_here
